{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Plugpass",
  "colors": {
    "primary": "#6932FF",
    "light": "#FFFFFF",
    "dark": "#6932FF"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://plugpass.ai"
  },
  "fonts": {
    "family": "DM Sans",
    "source": "/fonts/dm-sans-latin-opsz-normal.woff2",
    "format": "woff2"
  },
  "appearance": {
    "default": "system",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#09090B"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Pricing page",
        "pages": [
          "plan-data"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://plugpass.ai/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude"
    ]
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.plugpass.ai"
    }
  },
  "integrations": {
    "telemetry": {
      "enabled": false
    }
  }
}
